#X obj 120 50 r \$0-input;
#X obj 260 20 catch~ \$0-outL;
#X obj 400 20 catch~ \$0-outR;
#X obj 260 80 *~ 0;
#X obj 400 80 *~ 0;
#X obj 260 110 outlet~;
#X obj 400 110 outlet~;
#X obj 330 50 r \$0-master;
#X obj 20 170 loadbang;
#X msg 20 200 0.5;
#X obj 20 230 s \$0-input-set;
#X obj 160 230 s \$0-master-set;
#X obj 260 170 r \$0-dsp;
#X msg 260 200 \; pd dsp \$1;
#X text 20 270 inlets -> tracks -> outlets. sliders on the panel set the gains.;
