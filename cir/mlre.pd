#N canvas 60 60 1000 620 12;
#X text 20 10 mlre - live cutting with cir~ (after mlr / mlre for norns);;
#X text 20 40 trk  cut / position (click a cell to jump)                 play rec semi rev lo hi len    level     pre  pan    filt    cutoff   grp ld clr;
#X obj 20 65 mlre-track 1;
#X obj 20 97 mlre-track 2;
#X obj 20 129 mlre-track 3;
#X obj 20 161 mlre-track 4;
#X obj 20 193 mlre-track 5;
#X obj 20 225 mlre-track 6;
#X text 20 265 patterns: click once = record \, again = stop rec + loop \, again = stop \, again = play. right button = clear.;
#X obj 20 290 mlre-pattern 1;
#X obj 162 290 mlre-pattern 2;
#X obj 304 290 mlre-pattern 3;
#X obj 446 290 mlre-pattern 4;
#X obj 20 350 adc~ 1 2;
#X obj 20 380 +~;
#X obj 20 410 *~ 0.5;
#X obj 20 440 s~ mlre-in;
#X obj 110 380 hsl 100 18 0 1 0 0 empty empty input -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 280 350 catch~ mlre-outL;
#X obj 280 380 catch~ mlre-outR;
#X obj 280 410 *~ 0.5;
#X obj 330 410 *~ 0.5;
#X obj 280 440 dac~ 1 2;
#X obj 380 380 hsl 100 18 0 1 0 0 empty empty master -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 560 350 loadbang;
#X msg 560 380 0.5;
#X msg 560 420 \; pd dsp 1;
#X msg 650 420 \; pd dsp 0;
#X text 20 480 tips: play = start from where it was. rec overdubs while the track plays (pre = how much old audio stays). semi = transpose in semitones (12 = double speed) \, rev = reverse. filt: off / lowpass / highpass. lo/hi = loop between those cells. len = clip seconds (set by loading a file). tracks with the same grp number (1-9) stop each other.;
#X text 20 560 remote control: [s mlre-cue] <track> <cell 0-15 or -1 stop> \, [s mlre-pat-N] bang \, [s mlre-load-N] <path>;;
#X connect 13 0 14 0;
#X connect 13 1 14 1;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 17 0 15 1;
#X connect 18 0 20 0;
#X connect 19 0 21 0;
#X connect 20 0 22 0;
#X connect 21 0 22 1;
#X connect 23 0 20 1;
#X connect 23 0 21 1;
#X connect 24 0 25 0;
#X connect 25 0 17 0;
#X connect 25 0 23 0;
