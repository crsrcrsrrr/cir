#N canvas 80 60 820 640 12;
#X text 20 14 cir~ - norns softcut-style circular buffer voice;
#X text 20 38 Records into and plays from a Pd array. Loops and position jumps crossfade over fade_time. Use several [cir~] on one array for multiple voices. Times are in seconds.;
#N canvas 0 0 450 300 (subpatch) 0;
#X array cirbuf 480000 float 0;
#X coords 0 1 480000 -1 400 100 1 0 0;
#X restore 380 110 graph;
#X obj 20 470 adc~;
#X obj 20 520 cir~ cirbuf;
#X obj 20 590 dac~;
#X msg 20 110 play 1;
#X msg 80 110 play 0;
#X msg 20 140 rec 1;
#X msg 80 140 rec 0;
#X msg 20 180 rate 1;
#X msg 80 180 rate 0.5;
#X msg 155 180 rate -1;
#X msg 225 180 rate 2;
#X msg 20 210 rate_slew_time 0.5;
#X msg 20 250 pre_level 0.75;
#X msg 150 250 rec_level 1;
#X msg 20 290 loop_start 1 \, loop_end 3;
#X msg 220 290 loop_end -1;
#X msg 20 320 position 0;
#X msg 120 320 position 2.5;
#X msg 20 350 fade_time 0.05;
#X msg 20 380 level 0.5;
#X msg 110 380 level_slew_time 1;
#X msg 20 420 buffer_clear;
#X msg 130 420 print;
#X obj 140 560 snapshot~;
#X obj 140 490 loadbang;
#X obj 140 520 metro 50;
#X floatatom 140 590 8 0 0 0 - - - 0;
#X text 210 590 position (s);
#X msg 380 20 \; pd dsp 1;
#X text 380 250 Messages (as softcut):;
#X text 380 275 play 0/1 - start/stop (crossfaded);
#X text 380 298 rec 0/1 - record on/off (crossfaded);
#X text 380 321 rate f - speed \, negative = reverse;
#X text 380 344 rec_level f / pre_level f - buf = buf*pre + in*rec;
#X text 380 367 loop 0/1 \, loop_start f \, loop_end f (-1 = end);
#X text 380 390 position f - jump (crossfaded);
#X text 380 413 fade_time \, rate_slew_time \, level_slew_time \, recpre_slew_time;
#X text 380 436 level f \, set <array> \, buffer_clear \, buffer_clear_region start dur \, print;
#X text 380 470 Inlet: audio to record. Outlets: audio \, position in seconds. Load audio with [soundfiler]. Loop off = one-shot: stops at loop end until the next position.;
#X msg 150 140 loop 0;
#X msg 215 140 loop 1;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 0 5 1;
#X connect 6 0 4 0;
#X connect 7 0 4 0;
#X connect 8 0 4 0;
#X connect 9 0 4 0;
#X connect 10 0 4 0;
#X connect 11 0 4 0;
#X connect 12 0 4 0;
#X connect 13 0 4 0;
#X connect 14 0 4 0;
#X connect 15 0 4 0;
#X connect 16 0 4 0;
#X connect 17 0 4 0;
#X connect 18 0 4 0;
#X connect 19 0 4 0;
#X connect 20 0 4 0;
#X connect 21 0 4 0;
#X connect 22 0 4 0;
#X connect 23 0 4 0;
#X connect 24 0 4 0;
#X connect 25 0 4 0;
#X connect 4 1 26 0;
#X connect 27 0 28 0;
#X connect 28 0 26 0;
#X connect 26 0 29 0;
#X connect 42 0 4 0;
#X connect 43 0 4 0;
